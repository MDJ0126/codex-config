{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-line-central",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-line-central",
      "database_id": "ba0e46c3-39a0-4470-9972-83795148e473"
    }
  ]
}
