{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracefolio shared human/AI report contract v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "kind",
    "title",
    "summary",
    "outcome"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "project": {
      "enum": [
        "codex-config",
        "affinity-cli",
        "pixora",
        "designdatatable",
        "enginemigrator",
        "codeassist",
        "windowsfoldersize"
      ]
    },
    "kind": {
      "enum": [
        "result",
        "bug"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "workflow": {
      "enum": [
        "new",
        "review",
        "in_progress",
        "resolved",
        "closed"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "severity": {
      "enum": [
        "minor",
        "normal",
        "major",
        "critical"
      ]
    },
    "state": {
      "enum": [
        "complete",
        "partial",
        "progress",
        "verification",
        "blocked"
      ]
    },
    "reporter": {
      "type": "string",
      "maxLength": 5000
    },
    "assignee": {
      "type": "string",
      "maxLength": 5000
    },
    "environment": {
      "type": "string",
      "maxLength": 5000
    },
    "steps": {
      "type": "string",
      "maxLength": 5000
    },
    "expected": {
      "type": "string",
      "maxLength": 5000
    },
    "actual": {
      "type": "string",
      "maxLength": 5000
    },
    "cause": {
      "type": "string",
      "maxLength": 5000
    },
    "changes": {
      "type": "string",
      "maxLength": 5000
    },
    "verification": {
      "type": "string",
      "maxLength": 5000
    },
    "remaining": {
      "type": "string",
      "maxLength": 5000
    },
    "proposedTime": {
      "type": "string",
      "maxLength": 5000
    },
    "actualTime": {
      "type": "string",
      "maxLength": 5000
    },
    "xerjEvidence": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bug"
          }
        }
      },
      "then": {
        "required": [
          "environment",
          "steps",
          "expected",
          "actual"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bug"
          },
          "workflow": {
            "enum": [
              "resolved",
              "closed"
            ]
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "required": [
          "changes",
          "verification"
        ]
      }
    }
  ]
}
